# Copy values into environment variables or merge into ~/.dbt/profiles.yml.
# Never commit real tokens.

supply_chain_dwh:
  target: duckdb
  outputs:
    duckdb:
      type: duckdb
      path: "data/supply_chain_dwh.duckdb"
      threads: 4

    postgres:
      type: postgres
      host: "{{ env_var('DBT_HOST', 'localhost') }}"
      port: "{{ env_var('DBT_PORT', '5432') | int }}"
      user: "{{ env_var('DBT_USER', 'postgres') }}"
      password: "{{ env_var('DBT_PASSWORD', 'postgres') }}"
      dbname: "{{ env_var('DBT_DBNAME', 'supply_chain_dwh') }}"
      schema: public
      threads: 4

    # Databricks SQL Warehouse + Unity Catalog
    # Required env vars: DATABRICKS_HOST, DATABRICKS_HTTP_PATH, DATABRICKS_TOKEN
    databricks:
      type: databricks
      host: "{{ env_var('DATABRICKS_HOST') }}"
      http_path: "{{ env_var('DATABRICKS_HTTP_PATH') }}"
      token: "{{ env_var('DATABRICKS_TOKEN') }}"
      catalog: "{{ env_var('DATABRICKS_CATALOG', 'supply_chain_dwh') }}"
      schema: "{{ env_var('DATABRICKS_SCHEMA', 'warehouse') }}"
      threads: 4
      # Optional: auth_type: oauth  (instead of token)
